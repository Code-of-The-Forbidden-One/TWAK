#!/usr/bin/env bash
set -euo pipefail

trap 'printf "\nCancelled.\n" >&2; exit 130' INT

readonly TWK_VERSION="0.2.0"

resolve_script_path() {
    # Follows symlinks to the real script without GNU-only `readlink -f`.
    local path="$1"
    local dir
    while [[ -L "${path}" ]]; do
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        path="$(readlink "${path}")"
        [[ "${path}" == /* ]] || path="${dir}/${path}"
    done
    dir="$(cd -P "$(dirname "${path}")" && pwd)"
    printf '%s/%s\n' "${dir}" "$(basename "${path}")"
}

TWK_SCRIPT="$(resolve_script_path "${BASH_SOURCE[0]}")"
readonly TWK_SCRIPT
TWK_ROOT="$(cd "$(dirname "${TWK_SCRIPT}")/.." && pwd)"
readonly TWK_ROOT
readonly TWK_LIB="${TWK_ROOT}/lib"
# shellcheck disable=SC2034  # consumed by sourced libs (config.sh)
readonly TWK_CONFIG_DIR="${HOME}/.config/twk"
# Sessions live in ${TWK_DATA_ROOT}/scopes/<org>/<project>; config_load
# sets TWK_DATA_DIR once it knows the organisation and project.
# shellcheck disable=SC2034  # consumed by sourced libs (config.sh, session.sh)
readonly TWK_DATA_ROOT="${HOME}/.local/share/twk"
TWK_DATA_DIR="${TWK_DATA_ROOT}/scopes/_unconfigured"

# A private directory for this run only: holds the Azure CLI token, when
# TWK_AUTH=azcli, so requests share one token. Removed on exit.
TWK_RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/twk.XXXXXX")"
chmod 700 "${TWK_RUNTIME_DIR}"
readonly TWK_RUNTIME_DIR
# shellcheck disable=SC2034  # consumed by sourced libs (azdo.sh)
readonly TWK_TOKEN_CACHE="${TWK_RUNTIME_DIR}/token"
trap 'rm -rf "${TWK_RUNTIME_DIR}"' EXIT

# shellcheck source=lib/config.sh
source "${TWK_LIB}/config.sh"
# shellcheck source=lib/azdo.sh
source "${TWK_LIB}/azdo.sh"
# shellcheck source=lib/resolve.sh
source "${TWK_LIB}/resolve.sh"
# shellcheck source=lib/session.sh
source "${TWK_LIB}/session.sh"
# shellcheck source=lib/display.sh
source "${TWK_LIB}/display.sh"
# shellcheck source=lib/help.sh
source "${TWK_LIB}/help.sh"
# shellcheck source=lib/banner.sh
source "${TWK_LIB}/banner.sh"
# shellcheck source=lib/dispatch.sh
source "${TWK_LIB}/dispatch.sh"

check_dependencies() {
    local missing=()
    local dep
    for dep in curl jq; do
        if ! command -v "${dep}" &> /dev/null; then
            missing+=("${dep}")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: missing required dependencies: ${missing[*]}" >&2
        echo "Install them and try again." >&2
        exit 1
    fi
}

check_dependencies

main "$@"
