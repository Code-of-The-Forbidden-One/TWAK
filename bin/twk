#!/usr/bin/env bash
set -euo pipefail

trap 'printf "\nCancelled.\n" >&2; exit 130' INT

readonly TWK_VERSION="0.1.0"
TWK_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
readonly TWK_SCRIPT
TWK_ROOT="$(cd "$(dirname "${TWK_SCRIPT}")/.." && pwd)"
readonly TWK_ROOT
readonly TWK_LIB="${TWK_ROOT}/lib"
# shellcheck disable=SC2034  # consumed by sourced libs (config.sh, session.sh)
readonly TWK_CONFIG_DIR="${HOME}/.config/twk"
# shellcheck disable=SC2034  # consumed by sourced libs (session.sh)
readonly TWK_DATA_DIR="${HOME}/.local/share/twk/sessions"

# shellcheck source=lib/config.sh
source "${TWK_LIB}/config.sh"
# shellcheck source=lib/azdo.sh
source "${TWK_LIB}/azdo.sh"
# shellcheck source=lib/resolve.sh
source "${TWK_LIB}/resolve.sh"
# shellcheck source=lib/session.sh
source "${TWK_LIB}/session.sh"
# shellcheck source=lib/display.sh
source "${TWK_LIB}/display.sh"
# shellcheck source=lib/help.sh
source "${TWK_LIB}/help.sh"
# shellcheck source=lib/banner.sh
source "${TWK_LIB}/banner.sh"
# shellcheck source=lib/dispatch.sh
source "${TWK_LIB}/dispatch.sh"

check_dependencies() {
    local missing=()
    local dep
    for dep in curl jq bc; do
        if ! command -v "${dep}" &> /dev/null; then
            missing+=("${dep}")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: missing required dependencies: ${missing[*]}" >&2
        echo "Install them and try again." >&2
        exit 1
    fi
}

check_dependencies

main "$@"
